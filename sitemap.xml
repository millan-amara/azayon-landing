<?xml version="1.0" encoding="UTF-8"?>
<!--
  Marketing site sitemap. The home page is one HTML file with virtual pages
  (home, pricing, about) controlled by JS — Google strips hash fragments
  before indexing, so they're not listed separately. Privacy and Terms have
  their own real URLs via the _redirects rewrite.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.sitemaps.org/schemas/sitemap/0.9
                            http://www.sitemaps.org/schemas/sitemap/0.9/sitemap.xsd">

  <url>
    <loc>https://azayon.com/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>

  <url>
    <loc>https://azayon.com/privacy</loc>
    <changefreq>yearly</changefreq>
    <priority>0.4</priority>
  </url>

  <url>
    <loc>https://azayon.com/terms</loc>
    <changefreq>yearly</changefreq>
    <priority>0.4</priority>
  </url>

</urlset>
