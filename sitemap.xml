<?xml version="1.0" encoding="UTF-8"?>
<!--
  Marketing site sitemap. The site is a single HTML file with three "virtual"
  pages (home, pricing, about) controlled by JS via showPage(). Search engines
  see all the content under one URL. Hash anchors are included so we can
  preserve deep links to known sections (#features, #pricing) which Google
  uses as sitelinks.
-->
<urlset xmlns="http://www.sitemap.org/schemas/0.9/sitemap.xsd"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.sitemaps.org/schemas/sitemap/0.9
                            http://www.sitemaps.org/schemas/sitemap/0.9/sitemap.xsd">

  <url>
    <loc>https://azayon.com/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>

  <url>
    <loc>https://azayon.com/#features</loc>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>

  <url>
    <loc>https://azayon.com/#pricing</loc>
    <changefreq>monthly</changefreq>
    <priority>0.9</priority>
  </url>

  <url>
    <loc>https://azayon.com/#about</loc>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>

  <url>
    <loc>https://azayon.com/privacy</loc>
    <changefreq>yearly</changefreq>
    <priority>0.4</priority>
  </url>

  <url>
    <loc>https://azayon.com/terms</loc>
    <changefreq>yearly</changefreq>
    <priority>0.4</priority>
  </url>

</urlset>
